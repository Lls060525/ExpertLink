@model DashboardVM
@{
    ViewData["Title"] = "Admin Dashboard";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h2 class="page-title mb-0">Dashboard</h2>
        <p class="text-muted mb-0">Overview of ExpertLink as of @DateTime.Now.ToString("dddd, d MMMM yyyy")</p>
    </div>
    <div class="d-flex gap-2">
        <select id="months" class="form-select form-select-sm" style="width:auto" aria-label="Period">
            <option value="3">Last 3 months</option>
            <option value="6" selected>Last 6 months</option>
            <option value="12">Last 12 months</option>
        </select>
        <a asp-action="ExportAppointments" class="btn btn-sm btn-outline-primary text-nowrap"><i class="bi bi-filetype-csv"></i> Export CSV</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3"><div class="card-soft stat-card d-flex gap-3 align-items-center"><span class="icon-circle"><i class="bi bi-cash-stack"></i></span><div><div class="value">@Helper.Money(Model.RevenueThisMonth)</div><div class="label">Revenue this month</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card-soft stat-card d-flex gap-3 align-items-center"><span class="icon-circle"><i class="bi bi-calendar-check"></i></span><div><div class="value">@Model.AppointmentsThisMonth</div><div class="label">Appointments this month</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card-soft stat-card d-flex gap-3 align-items-center"><span class="icon-circle"><i class="bi bi-people"></i></span><div><div class="value">@Model.Clients / @Model.Consultants</div><div class="label">Clients / Consultants</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card-soft stat-card d-flex gap-3 align-items-center"><span class="icon-circle"><i class="bi bi-star"></i></span><div><div class="value">@Model.AverageRating.ToString("0.00")</div><div class="label">Average rating</div></div></div></div>
</div>

@if (Model.AwaitingApproval.Count > 0)
{
    <div class="card-soft p-3 mb-4 border-warning">
        <h6 class="fw-bold"><i class="bi bi-hourglass-split text-warning"></i> Consultant applications awaiting approval (@Model.AwaitingApproval.Count)</h6>
        <div class="list-group list-group-flush">
            @foreach (var c in Model.AwaitingApproval)
            {
                <a asp-action="UserDetail" asp-route-id="@c.Id" class="list-group-item list-group-item-action d-flex align-items-center gap-3 bg-transparent">
                    <img src="@Helper.Avatar(c.PhotoURL)" class="avatar avatar-sm" alt="" />
                    <div class="flex-grow-1"><b>@c.Name</b> <span class="text-muted small">· @c.Title · @(c.Category?.Name)</span></div>
                    <small class="text-muted">@c.CreatedAt.ToString("d MMM yyyy")</small>
                    <i class="bi bi-chevron-right"></i>
                </a>
            }
        </div>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card-soft p-3 h-100">
            <h6 class="fw-bold">Bookings &amp; revenue</h6>
            <canvas id="trendChart" height="130"></canvas>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card-soft p-3 h-100">
            <h6 class="fw-bold">Appointment status</h6>
            <canvas id="statusChart" height="220"></canvas>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card-soft p-3 h-100">
            <h6 class="fw-bold">Revenue by specialty</h6>
            <canvas id="categoryChart" height="190"></canvas>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card-soft p-3 h-100">
            <h6 class="fw-bold">Top consultants (completed sessions)</h6>
            <canvas id="topChart" height="190"></canvas>
        </div>
    </div>
</div>

<div class="card-soft p-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="fw-bold mb-0">Latest bookings</h6>
        <a asp-action="Appointments" class="small">View all</a>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Ref</th><th>Client</th><th>Consultant</th><th>Service</th><th>Date</th><th>Fee</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var a in Model.Recent)
                {
                    <tr>
                        <td><a asp-controller="Appointment" asp-action="Details" asp-route-id="@a.Id">@a.Reference</a></td>
                        <td>@a.Client.Name</td>
                        <td>@a.Consultant.Name</td>
                        <td>@a.Service.Name</td>
                        <td>@a.Date.ToString("d MMM yyyy") <small class="text-muted">@a.StartTime.Time12()</small></td>
                        <td>@Helper.Money(a.Fee)</td>
                        <td><partial name="_StatusBadge" model="a.Status" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            const charts = [];
            const palette = ['#0f766e', '#f59e0b', '#6366f1', '#ef4444', '#14b8a6', '#8b5cf6', '#64748b', '#ec4899'];
            const money = v => 'RM ' + Number(v).toLocaleString('en-MY', { minimumFractionDigits: 0 });

            function themeDefaults() {
                const dark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
                Chart.defaults.color = dark ? '#cbd5e1' : '#475569';
                Chart.defaults.borderColor = dark ? 'rgba(148,163,184,.15)' : 'rgba(15,23,42,.08)';
                Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;
            }

            async function load() {
                themeDefaults();
                const months = document.getElementById('months').value;
                const r = await fetch('@Url.Action("ChartData")?months=' + months);
                const d = await r.json();
                charts.forEach(c => c.destroy());
                charts.length = 0;

                charts.push(new Chart(document.getElementById('trendChart'), {
                    data: {
                        labels: d.labels,
                        datasets: [
                            { type: 'bar', label: 'Bookings', data: d.bookings, backgroundColor: 'rgba(15,118,110,.75)', borderRadius: 6, yAxisID: 'y' },
                            { type: 'line', label: 'Revenue (RM)', data: d.revenue, borderColor: '#f59e0b', backgroundColor: '#f59e0b', tension: .35, yAxisID: 'y1' }
                        ]
                    },
                    options: {
                        responsive: true, interaction: { mode: 'index', intersect: false },
                        scales: {
                            y: { beginAtZero: true, title: { display: true, text: 'Bookings' } },
                            y1: { beginAtZero: true, position: 'right', grid: { drawOnChartArea: false }, ticks: { callback: money } }
                        },
                        plugins: { tooltip: { callbacks: { label: c => c.dataset.yAxisID === 'y1' ? ' Revenue: ' + money(c.raw) : ' Bookings: ' + c.raw } } }
                    }
                }));

                charts.push(new Chart(document.getElementById('statusChart'), {
                    type: 'doughnut',
                    data: { labels: d.status.map(s => s.label), datasets: [{ data: d.status.map(s => s.count), backgroundColor: palette, borderWidth: 0 }] },
                    options: { cutout: '62%', plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } } } }
                }));

                charts.push(new Chart(document.getElementById('categoryChart'), {
                    type: 'bar',
                    data: { labels: d.byCategory.map(c => c.label), datasets: [{ label: 'Revenue', data: d.byCategory.map(c => c.revenue), backgroundColor: palette, borderRadius: 6 }] },
                    options: { indexAxis: 'y', plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => ' ' + money(c.raw) } } }, scales: { x: { ticks: { callback: money } } } }
                }));

                charts.push(new Chart(document.getElementById('topChart'), {
                    type: 'bar',
                    data: { labels: d.topConsultants.map(c => c.name), datasets: [{ label: 'Sessions', data: d.topConsultants.map(c => c.sessions), backgroundColor: 'rgba(99,102,241,.75)', borderRadius: 6 }] },
                    options: {
                        plugins: { legend: { display: false }, tooltip: { callbacks: { afterLabel: c => 'Rating: ' + d.topConsultants[c.dataIndex].rating.toFixed(2) } } },
                        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                    }
                }));
            }

            document.getElementById('months').addEventListener('change', load);
            document.addEventListener('themechange', load);
            load();
        })();
    </script>
}
