@{
    ViewData["Title"] = "Privacy Policy";
}
<div class="card-soft p-4 p-md-5" style="max-width:820px;margin:auto">
    <h1 class="page-title">Privacy Policy</h1>
    <p class="text-muted">Last updated: @DateTime.Now.ToString("MMMM yyyy")</p>
    <h5 class="mt-4">What we collect</h5>
    <p>We only store the data needed to run the service: your name, email, phone number, profile photo, your appointments, payments (last 4 digits of the card only) and reviews.</p>
    <h5>How we use it</h5>
    <p>Your data is used to manage bookings, send confirmations, receipts and reminders, and to let consultants prepare for your session. Session notes are visible only to you, your consultant and administrators.</p>
    <h5>Security</h5>
    <p>Passwords are stored as salted hashes. Accounts are temporarily locked after 3 failed login attempts. Payment card numbers and CVV are never stored.</p>
    <h5>Your rights</h5>
    <p>You can update your profile at any time. Contact the administrator to deactivate your account.</p>
</div>
