@{
    int code = ViewBag.Code;
    ViewData["Title"] = code == 404 ? "Page Not Found" : code == 400 ? "Page Expired" : "Error " + code;
    string heading = code switch
    {
        404 => "We couldn't find that page",
        403 => "Access denied",
        400 => "This page has expired",
        _ => "Something went wrong"
    };
    string text = code switch
    {
        404 => "The page or record you are looking for does not exist or may have been removed.",
        400 => "The form was opened before you logged in or out (possibly in another tab), so its security token is no longer valid. Please go back, refresh the page and try again.",
        _ => "Please try again later."
    };
}
<div class="text-center py-5">
    <div class="display-1 fw-bold text-primary">@code</div>
    <h2 class="mt-2">@heading</h2>
    <p class="text-muted mx-auto" style="max-width:560px">@text</p>
    <div class="d-flex justify-content-center gap-2">
        @if (code == 400)
        {
            <button type="button" class="btn btn-outline-primary" onclick="history.back()"><i class="bi bi-arrow-left"></i> Go Back</button>
        }
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary"><i class="bi bi-house"></i> Back to Home</a>
    </div>
</div>
