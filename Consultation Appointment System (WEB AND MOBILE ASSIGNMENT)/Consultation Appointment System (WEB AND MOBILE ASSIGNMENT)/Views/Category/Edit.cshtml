@model CategoryVM
@{
    ViewData["Title"] = "Edit Category";
}
<div class="card-soft p-4 p-md-5 mx-auto" style="max-width:720px">
    <h4 class="fw-bold mb-4"><i class="bi bi-pencil-square text-primary"></i> Edit Category</h4>
    <form asp-action="Edit" method="post" novalidate>
        <partial name="_Form" model="Model" />
        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-primary">Save Changes</button>
            <a asp-action="Index" class="btn btn-light">Cancel</a>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
