@model List<Category>
@{
    ViewData["Title"] = "Categories";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="page-title mb-0">Categories</h2>
        <p class="text-muted mb-0">Consultation specialties shown to clients.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Import" class="btn btn-outline-primary"><i class="bi bi-upload"></i> Import CSV</a>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Category</a>
    </div>
</div>

<form method="get" class="mb-3" style="max-width:360px">
    <div class="input-group">
        <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search categories" data-search />
        <button class="btn btn-light border"><i class="bi bi-search"></i></button>
    </div>
</form>

<form method="post" id="batchForm">
    @Html.AntiForgeryToken()
    <div class="card-soft">
        <div class="d-flex flex-wrap align-items-center gap-2 p-3 border-bottom" id="batchBar">
            <span class="small text-muted"><span id="selCount">0</span> selected</span>
            <button type="submit" asp-action="BatchStatus" asp-route-active="true" class="btn btn-sm btn-outline-success batch-btn" disabled><i class="bi bi-eye"></i> Activate</button>
            <button type="submit" asp-action="BatchStatus" asp-route-active="false" class="btn btn-sm btn-outline-secondary batch-btn" disabled><i class="bi bi-eye-slash"></i> Deactivate</button>
            <button type="submit" asp-action="BatchDelete" class="btn btn-sm btn-outline-danger batch-btn" data-confirm-batch="Delete the selected categories? Categories in use will be skipped." disabled><i class="bi bi-trash"></i> Delete</button>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-3" style="width:40px"><input type="checkbox" class="form-check-input" id="checkAll" aria-label="Select all" /></th>
                        <th>Category</th><th>Description</th><th class="text-center">Consultants</th><th>Status</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="6"><div class="empty-state"><i class="bi bi-tags"></i>No categories found.</div></td></tr>
                    }
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="ps-3"><input type="checkbox" class="form-check-input row-check" name="ids" value="@c.Id" aria-label="Select @c.Name" /></td>
                            <td><div class="d-flex align-items-center gap-2"><span class="icon-circle" style="width:36px;height:36px;font-size:1rem"><i class="bi @c.Icon"></i></span><b>@c.Name</b></div></td>
                            <td class="small text-muted" style="max-width:360px">@c.Description</td>
                            <td class="text-center">@c.Consultants.Count</td>
                            <td><span class="badge @(c.IsActive ? "text-bg-success" : "text-bg-secondary")">@(c.IsActive ? "Active" : "Inactive")</span></td>
                            <td class="text-end pe-3 text-nowrap">
                                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-light"><i class="bi bi-pencil"></i> Edit</a>
                                <button type="button" class="btn btn-sm btn-light text-danger delete-one" data-id="@c.Id" data-name="@c.Name" disabled="@(c.Consultants.Count > 0)" title="@(c.Consultants.Count > 0 ? "In use - deactivate instead" : "Delete")"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</form>

<form asp-action="Delete" method="post" id="deleteOne" data-confirm="Delete this category?">
    <input type="hidden" name="id" id="deleteId" />
</form>

@section Scripts {
    <script>
        (function () {
            const all = document.getElementById('checkAll');
            const checks = () => [...document.querySelectorAll('.row-check')];
            function update() {
                const n = checks().filter(c => c.checked).length;
                document.getElementById('selCount').textContent = n;
                document.querySelectorAll('.batch-btn').forEach(b => b.disabled = n === 0);
                all.checked = n > 0 && n === checks().length;
                all.indeterminate = n > 0 && n < checks().length;
            }
            all.addEventListener('change', () => { checks().forEach(c => c.checked = all.checked); update(); });
            document.addEventListener('change', e => { if (e.target.classList.contains('row-check')) update(); });

            // Confirm before batch delete (button-specific action -> set form action then confirm)
            document.querySelector('[data-confirm-batch]').addEventListener('click', function (e) {
                e.preventDefault();
                const form = document.getElementById('batchForm');
                form.action = this.getAttribute('formaction');
                form.dataset.confirm = this.dataset.confirmBatch;
                form.requestSubmit();
            });
            document.querySelectorAll('.batch-btn:not([data-confirm-batch])').forEach(b => b.addEventListener('click', () => {
                delete document.getElementById('batchForm').dataset.confirm;
            }));

            document.querySelectorAll('.delete-one').forEach(b => b.addEventListener('click', () => {
                const f = document.getElementById('deleteOne');
                document.getElementById('deleteId').value = b.dataset.id;
                f.dataset.confirm = `Delete category "${b.dataset.name}"?`;
                f.requestSubmit();
            }));
        })();
    </script>
}
