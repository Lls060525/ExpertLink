@model TimeOffVM
@{
    ViewData["Title"] = "Time Off";
    var list = (List<TimeOff>)ViewBag.List;
}
<h2 class="page-title mb-0">Time Off</h2>
<p class="text-muted">Block specific dates (leave, public holidays). Clients cannot book you on these days.</p>
<div class="row g-4">
    <div class="col-lg-5">
        <form asp-action="TimeOff" method="post" class="card-soft p-4" novalidate>
            <h6 class="fw-bold mb-3">Add a day off</h6>
            <div class="mb-3">
                <label asp-for="Date" class="form-label"></label>
                <input asp-for="Date" type="date" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@(Model.Date?.ToString("yyyy-MM-dd"))" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Reason" class="form-label">Reason <span class="text-muted small">(optional)</span></label>
                <input asp-for="Reason" class="form-control" placeholder="e.g. Annual leave" />
                <span asp-validation-for="Reason" class="text-danger"></span>
            </div>
            <button class="btn btn-primary"><i class="bi bi-calendar-x"></i> Block Date</button>
        </form>
    </div>
    <div class="col-lg-7">
        <div class="card-soft p-4">
            <h6 class="fw-bold mb-3">Upcoming time off</h6>
            @if (list.Count == 0)
            {
                <div class="empty-state py-3"><i class="bi bi-calendar-check"></i>No upcoming time off.</div>
            }
            <div class="list-group list-group-flush">
                @foreach (var t in list)
                {
                    <div class="list-group-item bg-transparent d-flex align-items-center gap-3 px-0">
                        <div class="text-center" style="width:54px">
                            <div class="small text-uppercase text-muted">@t.Date.ToString("MMM")</div>
                            <div class="fs-4 fw-bold lh-1">@t.Date.Day</div>
                        </div>
                        <div class="flex-grow-1"><b>@t.Date.ToString("dddd")</b><div class="small text-muted">@(t.Reason ?? "No reason given")</div></div>
                        <form asp-action="DeleteTimeOff" method="post" data-confirm="Remove this day off?">
                            <input type="hidden" name="id" value="@t.Id" />
                            <button class="btn btn-sm btn-light text-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
