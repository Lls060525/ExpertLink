@model ServiceVM
@{
    bool isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New Service" : "Edit Service";
}
<div class="card-soft p-4 p-md-5 mx-auto" style="max-width:720px">
    <h4 class="fw-bold mb-4"><i class="bi @(isNew ? "bi-plus-circle" : "bi-pencil-square") text-primary"></i> @ViewData["Title"]</h4>
    <form asp-action="@(isNew ? "CreateService" : "EditService")" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
        <input type="hidden" asp-for="Id" />
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. 60-min Tax Planning Session" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3" maxlength="500"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="DurationMinutes" class="form-label"></label>
                <select asp-for="DurationMinutes" class="form-select">
                    @foreach (var m in new[] { 15, 30, 45, 60, 90, 120, 180 })
                    {
                        <option value="@m">@m minutes</option>
                    }
                </select>
                <span asp-validation-for="DurationMinutes" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Fee" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">RM</span>
                    <input asp-for="Fee" class="form-control" type="number" step="0.01" min="0" max="10000" />
                </div>
                <span asp-validation-for="Fee" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label class="form-label">Consultation mode</label>
                <div class="d-flex gap-4">
                    <div class="form-check"><input asp-for="AllowOnline" class="form-check-input" /><label asp-for="AllowOnline" class="form-check-label"></label></div>
                    <div class="form-check"><input asp-for="AllowInPerson" class="form-check-input" /><label asp-for="AllowInPerson" class="form-check-label"></label></div>
                </div>
                <span asp-validation-for="AllowOnline" class="text-danger"></span>
            </div>
            <div class="col-12">
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
                <small class="text-muted">Inactive services are hidden from clients. Changing the fee or duration only affects new bookings.</small>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-primary">@(isNew ? "Create Service" : "Save Changes")</button>
            <a asp-action="Services" class="btn btn-light">Cancel</a>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
