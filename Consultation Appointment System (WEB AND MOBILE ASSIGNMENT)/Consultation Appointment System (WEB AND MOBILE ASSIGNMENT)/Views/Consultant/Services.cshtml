@model List<Service>
@{
    ViewData["Title"] = "My Services";
    var bookings = (Dictionary<int, int>)ViewBag.Bookings;
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="page-title mb-0">My Services</h2>
        <p class="text-muted mb-0">Consultation packages that clients can book.</p>
    </div>
    <a asp-action="CreateService" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Service</a>
</div>
@if (Model.Count == 0)
{
    <div class="card-soft empty-state"><i class="bi bi-briefcase"></i>You have not created any services yet.<br /><a asp-action="CreateService" class="btn btn-primary mt-3">Create your first service</a></div>
}
<div class="row g-3">
    @foreach (var s in Model)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card-soft p-3 h-100 d-flex flex-column @(s.IsActive ? "" : "opacity-75")">
                <div class="d-flex justify-content-between align-items-start">
                    <h6 class="fw-bold mb-1">@s.Name</h6>
                    <span class="badge @(s.IsActive ? "text-bg-success" : "text-bg-secondary")">@(s.IsActive ? "Active" : "Inactive")</span>
                </div>
                <p class="small text-muted flex-grow-1">@s.Description</p>
                <div class="d-flex flex-wrap gap-1 mb-3">
                    <span class="chip"><i class="bi bi-clock"></i> @s.DurationMinutes min</span>
                    @if (s.AllowOnline) { <span class="chip"><i class="bi bi-camera-video"></i> Online</span> }
                    @if (s.AllowInPerson) { <span class="chip"><i class="bi bi-geo-alt"></i> In-person</span> }
                    <span class="chip"><i class="bi bi-calendar-check"></i> @bookings[s.Id] booking(s)</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <b class="fs-5">@Helper.Money(s.Fee)</b>
                    <div class="d-flex gap-1">
                        <a asp-action="EditService" asp-route-id="@s.Id" class="btn btn-sm btn-light"><i class="bi bi-pencil"></i> Edit</a>
                        <form asp-action="DeleteService" method="post" data-confirm="@(bookings[s.Id] > 0 ? "This service has bookings and will be deactivated instead. Continue?" : "Delete this service?")">
                            <input type="hidden" name="id" value="@s.Id" />
                            <button class="btn btn-sm btn-light text-danger" title="Delete"><i class="bi bi-trash"></i></button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
