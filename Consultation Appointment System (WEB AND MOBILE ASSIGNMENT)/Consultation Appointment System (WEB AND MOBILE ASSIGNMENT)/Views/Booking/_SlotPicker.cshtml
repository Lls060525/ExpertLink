@* Calendar + slot grid used by Book and Reschedule. Model = service id; ViewData["Exclude"] = appointment being rescheduled *@
@model int
<div id="slotPicker" class="cal" data-service-id="@Model" data-exclude="@(ViewData["Exclude"] ?? 0)" data-max-days="60">
    <div class="row g-4">
        <div class="col-md-6">
            <div class="cal-head">
                <button type="button" class="btn btn-sm btn-light cal-prev" aria-label="Previous month"><i class="bi bi-chevron-left"></i></button>
                <b class="cal-title"></b>
                <button type="button" class="btn btn-sm btn-light cal-next" aria-label="Next month"><i class="bi bi-chevron-right"></i></button>
            </div>
            <div class="cal-grid"></div>
            <div class="small text-muted mt-2"><i class="bi bi-info-circle"></i> Days show the number of free slots. Bookings close @SlotService.MinLeadHours hours before the session.</div>
        </div>
        <div class="col-md-6">
            <h6 class="fw-bold" id="slotTitle">Select a date</h6>
            <div id="slots"><div class="empty-state py-4"><i class="bi bi-calendar2-week"></i>Pick a date on the calendar to see available times.</div></div>
        </div>
    </div>
</div>
