@model ChangePasswordVM
@{
    ViewData["Title"] = "Change Password";
}
<div class="card-soft p-4 p-md-5 mx-auto" style="max-width:520px">
    <h4 class="fw-bold mb-4"><i class="bi bi-key text-primary"></i> Change Password</h4>
    <form asp-action="ChangePassword" method="post" novalidate>
        <div class="mb-3">
            <label asp-for="Current" class="form-label"></label>
            <input asp-for="Current" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Current" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="New" class="form-label"></label>
            <div class="input-group">
                <input asp-for="New" class="form-control" autocomplete="new-password" />
                <button type="button" class="btn btn-outline-secondary pw-toggle" tabindex="-1"><i class="bi bi-eye"></i></button>
            </div>
            <div class="progress mt-2" style="height:5px"><div class="progress-bar" id="pwStrength" style="width:0"></div></div>
            <small class="text-muted" id="pwStrengthText"></small>
            <span asp-validation-for="New" class="text-danger d-block"></span>
        </div>
        <div class="mb-4">
            <label asp-for="Confirm" class="form-label"></label>
            <input asp-for="Confirm" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Confirm" class="text-danger"></span>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary">Update Password</button>
            <a asp-action="Profile" class="btn btn-light">Cancel</a>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_PasswordStrength" />
}
