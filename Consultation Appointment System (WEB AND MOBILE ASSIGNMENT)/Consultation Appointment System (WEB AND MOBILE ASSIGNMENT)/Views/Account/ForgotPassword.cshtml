@model ForgotPasswordVM
@{
    ViewData["Title"] = "Forgot Password";
}
<div class="card-soft p-4 p-md-5 mx-auto" style="max-width:480px">
    <div class="text-center mb-4">
        <span class="icon-circle mb-2"><i class="bi bi-key"></i></span>
        <h4 class="fw-bold">Forgot your password?</h4>
        <p class="text-muted small">Enter your email and we'll send you a link to reset it.</p>
    </div>
    <form asp-action="ForgotPassword" method="post" novalidate>
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autofocus />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <partial name="_Captcha" />
        <button class="btn btn-primary w-100">Send Reset Link</button>
    </form>
    <p class="text-center small mt-3 mb-0"><a asp-action="Login"><i class="bi bi-arrow-left"></i> Back to login</a></p>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
