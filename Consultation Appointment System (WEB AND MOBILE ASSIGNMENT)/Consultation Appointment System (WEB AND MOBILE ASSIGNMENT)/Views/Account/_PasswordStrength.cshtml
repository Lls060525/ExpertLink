<script>
    // Password strength meter
    (function () {
        const pw = document.getElementById('Password') || document.getElementById('New');
        const bar = document.getElementById('pwStrength'), txt = document.getElementById('pwStrengthText');
        if (!pw || !bar) return;
        pw.addEventListener('input', () => {
            const v = pw.value;
            let score = 0;
            if (v.length >= 8) score++;
            if (v.length >= 12) score++;
            if (/[a-z]/.test(v) && /[A-Z]/.test(v)) score++;
            if (/\d/.test(v)) score++;
            if (/[^A-Za-z0-9]/.test(v)) score++;
            const levels = [['0%', 'bg-danger', '8+ characters with upper, lower case and a digit'], ['20%', 'bg-danger', 'Very weak'], ['40%', 'bg-warning', 'Weak'], ['60%', 'bg-info', 'Fair'], ['80%', 'bg-success', 'Strong'], ['100%', 'bg-success', 'Very strong']];
            const [w, cls, label] = levels[v ? score : 0];
            bar.style.width = w;
            bar.className = 'progress-bar ' + cls;
            txt.textContent = label;
        });
    })();
</script>
