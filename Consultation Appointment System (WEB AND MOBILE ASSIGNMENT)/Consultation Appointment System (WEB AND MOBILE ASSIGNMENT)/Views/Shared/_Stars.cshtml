@model double
@{
    var full = (int)Math.Floor(Model);
    var half = Model - full >= 0.5;
}
<span class="stars" title="@Model.ToString("0.0") / 5">
    @for (int i = 1; i <= 5; i++)
    {
        if (i <= full) { <i class="bi bi-star-fill"></i> }
        else if (i == full + 1 && half) { <i class="bi bi-star-half"></i> }
        else { <i class="bi bi-star"></i> }
    }
</span>
