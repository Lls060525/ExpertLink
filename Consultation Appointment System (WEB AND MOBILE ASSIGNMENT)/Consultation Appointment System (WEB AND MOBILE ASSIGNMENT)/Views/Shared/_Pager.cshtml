@* Reusable pager. Links keep the current query string (filters, sort). *@
@model PagerVM
@{
    string Link(int p)
    {
        var q = Context.Request.Query.ToDictionary(k => k.Key, v => (string?)v.Value.ToString());
        q["page"] = p.ToString();
        return Context.Request.Path + QueryString.Create(q).ToString();
    }
    int start = Math.Max(1, Model.Page - 2), end = Math.Min(Model.TotalPages, Model.Page + 2);
}
@if (Model.TotalPages > 1)
{
    <nav aria-label="Pages">
        <ul class="pagination pagination-sm justify-content-center mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(Model.Page - 1)" data-page="@(Model.Page - 1)">&laquo;</a></li>
            @for (int p = start; p <= end; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" href="@Link(p)" data-page="@p">@p</a></li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")"><a class="page-link" href="@Link(Model.Page + 1)" data-page="@(Model.Page + 1)">&raquo;</a></li>
        </ul>
    </nav>
}
